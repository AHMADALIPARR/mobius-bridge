{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MobiusPayload",
  "type": "object",
  "required": ["protocol_version", "experiment_id", "iteration", "param_dim", "parameters", "energy", "uncertainty", "digest", "sequence_id"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "experiment_id": { "type": "string", "format": "uuid" },
    "iteration": { "type": "integer", "minimum": 0, "maximum": 14 },
    "param_dim": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "parameters": {
      "type": "array",
      "items": { "type": "number", "minimum": -3.1415926535, "maximum": 3.1415926535 },
      "minItems": 1,
      "maxItems": 1024
    },
    "energy": { "type": "number" },
    "uncertainty": { "type": "number", "minimum": 0 },
    "digest": { "type": "string", "minLength": 64, "maxLength": 64 },
    "sequence_id": { "type": "integer", "minimum": 0 }
  }
}
